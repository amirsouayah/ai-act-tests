{
  "name": "ai-act-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Tests automatisés de conformité AI Act (article 50 et illustrations haut risque) avec Playwright",
  "scripts": {
    "demo": "node demo/server.mjs",
    "demo:non-conforme": "node demo/server.mjs --non-conforme",
    "test": "playwright test",
    "test:detection": "node scripts/verifier-detection.mjs",
    "rapport:conforme": "playwright show-report playwright-report",
    "rapport:non-conforme": "playwright show-report playwright-report-non-conforme --port 9324",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.10.0",
    "playwright-core": "1.56.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
